<!DOCTYPE html>
<html lang="{{ str_replace('_', '-', app()->getLocale()) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ config('app.name', 'Laravel') }}</title>
    <style>
        :root {
            --bg: #f7f7fb; --text: #14142b; --muted: #5c5c7a; --card: rgba(255,255,255,.75);
            --border: rgba(20,20,43,.08); --accent: #6d5dfc; --accent2: #b44cf5; --shadow: 0 20px 50px -20px rgba(109,93,252,.35);
        }
        @@media (prefers-color-scheme: dark) {
            :root {
                --bg: #0b0b17; --text: #f1f1fb; --muted: #a0a0c0; --card: rgba(255,255,255,.06);
                --border: rgba(255,255,255,.1); --shadow: 0 20px 60px -20px rgba(0,0,0,.8);
            }
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            min-height: 100vh; background: var(--bg); color: var(--text);
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.5; overflow-x: hidden; -webkit-font-smoothing: antialiased;
        }
        .blob { position: fixed; border-radius: 50%; filter: blur(90px); opacity: .45; z-index: 0; pointer-events: none; }
        .b1 { width: 420px; height: 420px; background: #6d5dfc; top: -120px; left: -100px; animation: drift 14s ease-in-out infinite; }
        .b2 { width: 360px; height: 360px; background: #f06bd0; top: 30%; right: -120px; animation: drift 18s ease-in-out infinite reverse; }
        .b3 { width: 400px; height: 400px; background: #38bdf8; bottom: -160px; left: 30%; opacity: .35; animation: drift 22s ease-in-out infinite; }
        @@keyframes drift { 0%,100% { transform: translate(0,0); } 50% { transform: translate(40px,30px); } }
        @@keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
        @@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

        .wrap { position: relative; z-index: 1; max-width: 1080px; margin: 0 auto; padding: 0 24px; }
        header { display: flex; align-items: center; justify-content: space-between; padding: 24px 0; }
        .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.15rem; text-decoration: none; color: inherit; }
        .logo { width: 36px; height: 36px; border-radius: 11px; display: grid; place-items: center; color: #fff; font-weight: 800;
                background: linear-gradient(135deg, var(--accent), var(--accent2)); box-shadow: 0 8px 20px -6px var(--accent); }
        nav { display: flex; gap: 8px; align-items: center; }
        .link { padding: 10px 16px; border-radius: 999px; text-decoration: none; color: var(--muted); font-weight: 600; font-size: .92rem; transition: color .2s; }
        .link:hover { color: var(--text); }

        .btn { display: inline-block; padding: 12px 26px; border-radius: 999px; text-decoration: none; font-weight: 700; font-size: .95rem; transition: transform .2s, box-shadow .2s; }
        .btn:hover { transform: translateY(-2px); }
        .btn-primary { color: #fff; background: linear-gradient(135deg, var(--accent), var(--accent2)); box-shadow: 0 12px 28px -8px var(--accent); }
        .btn-ghost { color: var(--text); background: var(--card); border: 1px solid var(--border); backdrop-filter: blur(10px); }

        .hero { text-align: center; padding: 72px 0 40px; animation: rise .8s ease both; }
        .pill { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px; font-size: .8rem; font-weight: 600;
                background: var(--card); border: 1px solid var(--border); color: var(--muted); backdrop-filter: blur(10px); }
        .dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34,197,94,.2); }
        h1 { font-size: clamp(2.4rem, 7vw, 4.6rem); line-height: 1.05; letter-spacing: -.03em; font-weight: 800; margin: 24px 0 20px; }
        .grad { background: linear-gradient(90deg, var(--accent), var(--accent2), #38bdf8); -webkit-background-clip: text; background-clip: text; color: transparent; }
        .lead { max-width: 540px; margin: 0 auto 34px; color: var(--muted); font-size: 1.1rem; }
        .actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

        .preview { margin: 40px auto 0; max-width: 820px; padding: 14px; border-radius: 26px; background: var(--card); border: 1px solid var(--border);
                   box-shadow: var(--shadow); backdrop-filter: blur(14px); animation: float 6s ease-in-out infinite; }
        .preview-inner { border-radius: 18px; padding: 22px; border: 1px solid var(--border); }
        .dots span { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 6px; }
        .dots span:nth-child(1) { background: #fb7185; } .dots span:nth-child(2) { background: #fbbf24; } .dots span:nth-child(3) { background: #34d399; }
        .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 20px; }
        .stat { padding: 18px; border-radius: 16px; border: 1px solid var(--border); text-align: left; }
        .stat small { color: var(--muted); font-size: .8rem; }
        .stat strong { display: block; font-size: 1.8rem; letter-spacing: -.02em; }
        .bar { height: 10px; border-radius: 99px; background: var(--border); margin-top: 14px; overflow: hidden; }
        .bar i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--accent), var(--accent2)); }

        .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; padding: 70px 0; }
        .card { padding: 26px; border-radius: 22px; background: var(--card); border: 1px solid var(--border); backdrop-filter: blur(10px); transition: transform .25s, box-shadow .25s; }
        .card:hover { transform: translateY(-5px); box-shadow: var(--shadow); }
        .icon { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; font-size: 1.2rem; margin-bottom: 16px;
                background: linear-gradient(135deg, rgba(109,93,252,.18), rgba(180,76,245,.18)); }
        .card h3 { font-size: 1.05rem; margin-bottom: 6px; }
        .card p { color: var(--muted); font-size: .92rem; }

        footer { text-align: center; padding: 28px 0 36px; color: var(--muted); font-size: .8rem; border-top: 1px solid var(--border); }

        @@media (max-width: 720px) {
            .stats, .features { grid-template-columns: 1fr; }
            .hero { padding-top: 40px; }
        }
    </style>
</head>
