
<?php
require_once "../dao/config.php";

if (isset($_POST['save'])) {

    $username = $_POST['username'];
    $lname = $_POST['lname'];
    $firstname = $_POST['firstname'];
    $password = password_hash($_POST['password'], PASSWORD_DEFAULT);
    $email = $_POST['email'];
    $status = $_POST['status'];

    $sql = "INSERT INTO users
            (username, lname, firstname, password, email, status)
            VALUES (?, ?, ?, ?, ?, ?)";

    $stmt = $db->prepare($sql);
    $stmt->execute([
        $username,
        $lname,
        $firstname,
        $password,
        $email,
        $status
    ]);

    header("Location: read.php");
    exit;
}
?>

